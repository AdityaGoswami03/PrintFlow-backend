# Application Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database (Atlas or Local)
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=printflow

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random
JWT_EXPIRES_IN=7d

# Storage Provider: 'local', 's3', or 'r2'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# S3 / Cloudflare R2 Credentials (Required if STORAGE_PROVIDER is 's3' or 'r2')
S3_BUCKET_NAME=printflow-documents
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
# S3_ENDPOINT is required for Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Document Security & Retention Policy
DOC_RETENTION_HOURS=24
SIGNED_URL_EXPIRES_SECONDS=900
